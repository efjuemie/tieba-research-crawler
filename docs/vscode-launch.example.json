{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TiebaScraper: Backfill",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "backfill"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TiebaScraper: Resume backfill",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "backfill", "--resume"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TiebaScraper: Export all runs",
      "type": "debugpy",
      "request": "launch",
      "module": "src.research",
      "args": ["export"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
